# Use scripts/setup_local.py to generate persistent secrets for a new installation.
SECRET_KEY=replace-with-a-long-random-secret
ENCRYPTION_KEY=replace-with-a-generated-fernet-key
RECOVERY_CODE_KEY=replace-with-a-different-generated-fernet-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# For SMTP delivery, use django.core.mail.backends.smtp.EmailBackend and configure:
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
# For Mailjet HTTPS delivery, select anymail.backends.mailjet.EmailBackend instead.
# Set DEFAULT_FROM_EMAIL to the address verified in the Mailjet account.
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
# Production: DEBUG=False, real allowed hostname(s), and real HTTPS origin(s).
CSRF_TRUSTED_ORIGINS=
# Enable only behind a trusted proxy that strips client-supplied forwarding headers.
TRUST_PROXY_HEADERS=False
# Optional public demo. Run manage.py setup_public_demo and set its public password.
PUBLIC_DEMO_PASSWORD=
